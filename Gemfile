source "https://rubygems.org"

# Jekyll 4.x, built by GitHub Actions rather than the built-in Pages
# builder. The built-in builder is pinned to Jekyll 3.10.0 /
# jekyll-sass-converter 1.5.2 (Ruby Sass 3.7.4, EOL 2019), runs in safe
# mode, and cannot run the Node-based Decorator chrome-integrity gate.
gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
end
